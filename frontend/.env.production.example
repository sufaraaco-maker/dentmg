# Copy to frontend/.env.production and fill in before `npm run build` for a production deploy.
# Both values are baked into the client-side JS bundle at build time (Vite convention: any
# VITE_-prefixed var is public) — never put a secret behind a VITE_ prefix.

VITE_API_URL=https://your-production-domain.example/api
VITE_APP_URL=https://your-production-domain.example
