APP_NAME=DentalSuite
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The clinic's real IANA timezone — not UTC. This project stores wall-clock digits verbatim with no
# real timezone conversion (frontend/src/lib/date.ts), so now() must read the clinic's own
# wall-clock time for anything that compares now() against a stored timestamp or schedules an
# absolute daily run time (Phase 5C design doc §3.3a). Single-clinic V1; a future multi-clinic model
# moves this to a per-clinic ClinicSetting column instead.
APP_TIMEZONE=Africa/Cairo

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# General api/* rate limit (RateLimiter::for('api', ...) in AppServiceProvider). Raised only in
# CI's E2E job env — see .github/workflows/ci.yml — to accommodate the full Playwright suite's
# request volume against a single demo user within the throttle window. Leave at 120 elsewhere.
API_THROTTLE_PER_MINUTE=120

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=dentalsuite
DB_USERNAME=dentalsuite
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

VITE_APP_NAME="${APP_NAME}"
