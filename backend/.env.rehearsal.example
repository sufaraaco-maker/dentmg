# Throwaway env for docker-compose.rehearsal.yml only — never used by the real dev or
# production stacks. All values are dummy/fixed on purpose (this stack is destroyed at the end
# of every rehearsal via `docker compose -f docker-compose.rehearsal.yml down -v`, so there is
# nothing here worth keeping secret). No Redis dependency (file/sync drivers) since this stack
# only needs to run artisan CLI commands (migrate, down, up) and a database to restore into.
# See docs/deployment.md "Testing restore".
APP_NAME=DentalSuite
APP_ENV=local
APP_KEY=base64:XZQqxKHqZ8bYQFvNqRqQGqPGxwXPnFVJZ8yYqvhE9jQ=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=dentalsuite_rehearsal
DB_USERNAME=dentalsuite_rehearsal
DB_PASSWORD=rehearsal_only_secret

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log

FRONTEND_URL=http://localhost
SANCTUM_STATEFUL_DOMAINS=localhost
