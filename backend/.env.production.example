# Production environment template.
#
# backend/.env.example is for LOCAL DEVELOPMENT ONLY (APP_DEBUG=true, verbose logging, no
# secure-cookie flags — all deliberate for a comfortable dev loop). Never deploy that file
# unchanged. Copy THIS file to backend/.env on the production host, fill in every value marked
# CHANGE-ME, and generate a real APP_KEY (see docs/deployment.md "First boot"). The prod
# entrypoint (docker/php/entrypoint.prod.sh) refuses to start if .env is missing, if APP_KEY is
# unset, or if APP_ENV=local.

APP_NAME=DentalSuite
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE-ME.example

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=dentalsuite
DB_USERNAME=dentalsuite
DB_PASSWORD=CHANGE-ME-use-a-generated-32-char-secret

# Cross-origin cookie auth (Sanctum SPA) over real HTTPS requires all three of these to be
# correct, or login will silently fail (cookie rejected by the browser) — see
# docs/deployment.md "Sanctum / session cookies in production" for how to pick same_site.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@CHANGE-ME.example"
MAIL_FROM_NAME="${APP_NAME}"

# Only needed if FILESYSTEM_DISK=s3 (recommended once the Imaging/attachments module ships —
# patient files should not live on local disk with no offsite redundancy).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

FRONTEND_URL=https://CHANGE-ME.example
SANCTUM_STATEFUL_DOMAINS=CHANGE-ME.example

VITE_APP_NAME="${APP_NAME}"
